{
  "entities": {
    "user": {
      "title": "User",
      "description": "A user of the application.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The user's unique ID from Firebase Auth."
        },
        "email": {
          "type": "string",
          "description": "The user's email address.",
          "format": "email"
        },
        "displayName": {
          "type": "string",
          "description": "The user's display name."
        },
        "xavefId": {
          "type": "string",
          "description": "A unique 4 to 6 digit user ID, like an account number."
        },
        "referredBy": {
          "type": "string",
          "description": "The UID of the user who referred them."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp when the user account was created."
        }
      },
      "required": ["uid", "email", "displayName", "xavefId", "createdAt"]
    },
    "transaction": {
      "title": "Transaction",
      "description": "A financial transaction.",
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "format": "date-time"
        },
        "description": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": ["Deposit", "Withdrawal", "Loan Payment", "Interest"]
        },
        "status": {
          "type": "string",
          "enum": ["Completed", "Pending", "Failed"]
        },
        "amount": {
          "type": "number"
        }
      },
      "required": ["date", "description", "type", "status", "amount"]
    },
    "referralCode": {
      "title": "Referral Code",
      "description": "A one-time use referral code.",
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "creatorUid": {
          "type": "string"
        },
        "used": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["code", "creatorUid", "used", "createdAt"]
    }
  },
  "auth": {
    "providers": ["email"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/user"
      },
      "description": "Stores user profile information, including their unique Xavef ID and referral details."
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": {
        "$ref": "#/entities/transaction"
      },
      "description": "Stores a user's transactions."
    },
    "/referralCodes/{codeId}": {
      "schema": {
        "$ref": "#/entities/referralCode"
      },
      "description": "Stores one-time use referral codes."
    }
  }
}
