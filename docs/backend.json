{
  "entities": {
    "user": {
      "title": "User",
      "description": "A user of the application.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The user's unique ID from Firebase Auth."
        },
        "email": {
          "type": "string",
          "description": "The user's email address.",
          "format": "email"
        },
        "firstName": {
          "type": "string",
          "description": "The user's first name."
        },
        "lastName": {
          "type": "string",
          "description": "The user's last name."
        },
        "dateOfBirth": {
          "type": "string",
          "format": "date",
          "description": "The user's date of birth."
        },
        "phoneNumber": {
          "type": "string",
          "description": "The user's phone number."
        },
        "address": {
          "type": "string",
          "description": "The user's street address."
        },
        "state": {
          "type": "string",
          "description": "The user's state or province."
        },
        "country": {
          "type": "string",
          "description": "The user's country."
        },
        "xavefId": {
          "type": "string",
          "description": "A unique 4 to 6 digit user ID, like an account number."
        },
        "referredBy": {
          "type": "string",
          "description": "The UID of the user who referred them."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp when the user account was created."
        },
        "solidaraBalance": {
          "type": "number",
          "description": "The user's balance for the Solidara savings account."
        },
        "annualBalance": {
          "type": "number",
          "description": "The user's balance for the Annual savings account."
        }
      },
      "required": [
        "uid",
        "email",
        "xavefId",
        "createdAt",
        "referredBy"
      ]
    },
    "transaction": {
      "title": "Transaction",
      "description": "A financial transaction.",
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "format": "date-time"
        },
        "description": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "Deposit",
            "Withdrawal",
            "Loan Payment",
            "Interest"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "Completed",
            "Pending",
            "Failed"
          ]
        },
        "amount": {
          "type": "number"
        },
        "targetAccount": {
          "type": "string",
          "enum": [
            "solidara",
            "annual"
          ],
          "description": "The target account for the transaction, if applicable."
        },
        "proofOfPaymentUrl": {
          "type": "string",
          "description": "URL of the uploaded proof of payment image."
        }
      },
      "required": [
        "date",
        "description",
        "type",
        "status",
        "amount"
      ]
    },
    "referralCode": {
      "title": "Referral Code",
      "description": "A one-time use referral code.",
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "creatorUid": {
          "type": "string"
        },
        "used": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "code",
        "creatorUid",
        "used",
        "createdAt"
      ]
    },
    "admin": {
      "title": "Admin",
      "description": "A user with administrative privileges.",
      "type": "object",
      "properties": {
        "isAdmin": {
          "type": "boolean"
        }
      },
      "required": [
        "isAdmin"
      ]
    }
  },
  "auth": {
    "providers": [
      "email"
    ]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/user"
      },
      "description": "Stores user profile information, including their unique Xavef ID and referral details."
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": {
        "$ref": "#/entities/transaction"
      },
      "description": "Stores a user's transactions."
    },
    "/referralCodes/{codeId}": {
      "schema": {
        "$ref": "#/entities/referralCode"
      },
      "description": "Stores one-time use referral codes."
    },
    "/admins/{userId}": {
      "schema": {
        "$ref": "#/entities/admin"
      },
      "description": "Stores a list of admin users."
    }
  }
}
