
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      // The super admin is identified by their email. Other admins are in the /admins collection.
      return request.auth.token.email == 'admin@xavef.com' || exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Admins can perform a collection group query on transactions
    match /{path=**}/transactions/{transactionId} {
      allow list: if isAdmin();
    }

    match /users/{userId} {
      allow create: if isOwner(userId)
                    && request.resource.data.uid == userId
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.solidaraBalance == 0
                    && request.resource.data.annualBalance == 0;

      allow read: if isOwner(userId) || isAdmin();
      
      // Regular users can update their profile but not balances.
      // Admins can only update balances.
      allow update: if (isOwner(userId) &&
                        request.resource.data.solidaraBalance == resource.data.solidaraBalance &&
                        request.resource.data.annualBalance == resource.data.annualBalance)
                     || (isAdmin() && request.resource.data.keys().hasOnly(['solidaraBalance', 'annualBalance']));


      allow delete: if false; // Deleting user documents is disallowed.
      allow get, list: if isAdmin();
    }

    match /referralCodes/{codeId} {
      allow read: if request.auth != null;
      
      allow create: if request.auth != null 
      								&& request.resource.data.creatorUid == request.auth.uid
                      && exists(/databases/$(database)/documents/referralCodeGenerators/$(request.auth.uid));
      
      // A user can update a code to mark it as 'used' by them.
      allow update: if isOwner(request.resource.data.usedBy)
                     && request.resource.data.used == true
                     && resource.data.used == false;

      allow delete: if false;
    }

    match /referralCodeGenerators/{userId} {
      allow read, get: if request.auth != null;
      // Only the super admin can grant or revoke the ability to generate referral codes.
      allow create, delete: if request.auth.token.email == 'admin@xavef.com';
      allow list, update: if false;
    }

    match /users/{userId}/transactions/{transactionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow get, list, update: if isAdmin();
        allow delete: if false;
    }

    match /users/{userId}/goals/{goalId} {
        allow create, read, update, delete: if isOwner(userId);
    }

    match /admins/{userId} {
      allow read, get: if request.auth != null;
      // Only the super admin can manage the list of other admins
      allow create, delete: if request.auth.token.email == 'admin@xavef.com';
      allow list, update: if false;
    }
  }
}
