
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      // Allow the super admin full access, and check the admins collection for others.
      return request.auth.token.email == 'admin@xavef.com' || exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    function canGenerateCode(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.canGenerateReferralCode == true;
    }

    // Admins can perform a collection group query on transactions
    match /{path=**}/transactions/{transactionId} {
      allow list: if isAdmin();
    }

    match /users/{userId} {
      // A user can create their own user document if the data is valid and they are authenticated.
      allow create: if request.auth != null && request.auth.uid == userId 
                    && request.resource.data.uid == userId
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.solidaraBalance == 0
                    && request.resource.data.annualBalance == 0;

      // An authenticated user can read their own document.
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // A user can update their own data, except for protected fields.
      // The super admin can update only the permission field.
      allow update: if 
        // Rule for regular user updates: User can update their profile, but cannot change protected fields.
        (request.auth.uid == userId &&
          request.resource.data.solidaraBalance == resource.data.solidaraBalance &&
          request.resource.data.annualBalance == resource.data.annualBalance &&
          request.resource.data.canGenerateReferralCode == resource.data.canGenerateReferralCode
        ) ||
        // Rule for super admin permission updates: Admin can ONLY change the `canGenerateReferralCode` field.
        (request.auth.token.email == 'admin@xavef.com' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['canGenerateReferralCode'])
        );


      // Admins can read any user document.
      allow get, list: if isAdmin(); 
      // No one can delete user documents for now.
      allow delete: if false;
    }

    match /referralCodes/{codeId} {
      // An authenticated user needs to be able to check if a code exists during signup.
      // The transaction ensures they can't consume a used code.
      allow read: if request.auth != null;
      
      allow create: if request.auth != null 
      								&& request.resource.data.creatorUid == request.auth.uid
                      && canGenerateCode(request.auth.uid);
      
      // A user can mark a code as used as part of the transaction to create their own profile.
      // This rule ensures the 'used' field can only be changed from false to true.
      allow update: if request.auth != null 
                     && request.resource.data.used == true
                     && resource.data.used == false
                     && request.resource.data.usedBy == request.auth.uid;

      // No one can delete referral codes
      allow delete: if false;
    }

    match /users/{userId}/transactions/{transactionId} {
        // Users can read their own transactions
        allow read: if request.auth != null && request.auth.uid == userId;
        // Users can create their own transactions (deposits/withdrawals)
        allow create: if request.auth != null && request.auth.uid == userId;
        // Admins can read and update transactions (e.g., to change status)
        allow get, list, update: if isAdmin();
        // Users cannot update or delete their own transactions
        allow delete: if false;
    }

    match /users/{userId}/goals/{goalId} {
        // Users can manage their own saving goals.
        allow create, read, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    match /admins/{userId} {
      // Any authenticated user can check if another user is an admin.
      // This is safe as it only reveals a boolean status.
      allow read, get: if request.auth != null;
    }
  }
}
