
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth.token.email == 'admin@xavef.com' || exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Checks if the incoming write is only updating balance fields.
    function isBalanceUpdate() {
      let incomingKeys = request.resource.data.keys();
      let currentKeys = resource.data.keys();
      let balanceKeys = ['solidaraBalance', 'annualBalance'];
      // Ensures no fields are added or removed, only specific ones updated.
      return incomingKeys.hasAll(currentKeys) &&
             currentKeys.hasAll(incomingKeys) &&
             incomingKeys.removeAll(balanceKeys).size() == currentKeys.removeAll(balanceKeys).size();
    }

    match /{path=**}/transactions/{transactionId} {
      allow list: if isAdmin();
    }

    match /users/{userId} {
      // Users can create their own profile with specific constraints.
      allow create: if request.auth != null && request.auth.uid == userId 
                    && request.resource.data.uid == userId
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.solidaraBalance == 0
                    && request.resource.data.annualBalance == 0;

      // A user can read and update their own document, but NOT their balances.
      allow read, update: if request.auth != null && request.auth.uid == userId
                      && !(isBalanceUpdate());

      // An admin can get/list any user, and can UPDATE a user's document ONLY to change balances.
      allow get, list: if isAdmin();
      allow update: if isAdmin() && isBalanceUpdate();

      // Nobody can delete user documents.
      allow delete: if false;
    }

    match /referralCodes/{codeId} {
      allow read: if request.auth != null;
      // Allow any authenticated user to create a code for themselves.
      allow create: if request.auth != null && request.resource.data.creatorUid == request.auth.uid;
      
      // Allow a user to "use" a code (update the 'used' field) if it hasn't been used before.
      allow update: if request.auth != null 
                     && request.resource.data.used == true
                     && resource.data.used == false
                     && "usedBy" in request.resource.data && request.resource.data.usedBy == request.auth.uid;


      allow delete: if false;
    }

    match /users/{userId}/transactions/{transactionId} {
        allow read, create: if request.auth != null && request.auth.uid == userId;
        allow get, list, update: if isAdmin();
        allow delete: if false;
    }

    match /users/{userId}/goals/{goalId} {
        allow create, read, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    match /admins/{userId} {
      allow read, get: if request.auth != null;
      allow create, delete: if request.auth.token.email == 'admin@xavef.com';
    }
  }
}
