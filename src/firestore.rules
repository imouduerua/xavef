
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // A user's role (admin) is determined by a custom claim on their auth token.
    // This is more secure and efficient than checking the database on every request.
    function isAdmin() {
      return request.auth.token.admin == true;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    function canGenerateCode(userId) {
      return exists(/databases/$(database)/documents/referralCodeGenerators/$(userId));
    }

    // Admins can perform a collection group query on transactions
    match /{path=**}/transactions/{transactionId} {
      allow list: if isAdmin();
    }

    match /users/{userId} {
      allow create: if isOwner(userId)
                    && request.resource.data.uid == userId
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.solidaraBalance == 0
                    && request.resource.data.annualBalance == 0;

      allow read: if isOwner(userId) || isAdmin();
      
      allow update: if (isOwner(userId) &&
                        request.resource.data.solidaraBalance == resource.data.solidaraBalance &&
                        request.resource.data.annualBalance == resource.data.annualBalance)
                     || (isAdmin() && request.resource.data.keys().hasOnly(['solidaraBalance', 'annualBalance']));


      allow delete: if false; // Deleting user documents is disallowed.
      allow get, list: if isAdmin();
    }

    match /referralCodes/{codeId} {
      allow read: if request.auth != null;
      
      allow create: if request.auth != null 
      								&& request.resource.data.creatorUid == request.auth.uid
                      && canGenerateCode(request.auth.uid);
      
      allow update: if isOwner(request.resource.data.usedBy)
                     && request.resource.data.used == true
                     && resource.data.used == false;

      allow delete: if false;
    }

    match /referralCodeGenerators/{userId} {
      allow read, get: if request.auth != null;
      // Only admins can grant or revoke the ability to generate referral codes.
      allow create, delete: if isAdmin();
      allow list, update: if false;
    }

    match /users/{userId}/transactions/{transactionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow get, list, update: if isAdmin();
        allow delete: if false;
    }

    match /users/{userId}/goals/{goalId} {
        allow create, read, update, delete: if isOwner(userId);
    }

    match /admins/{userId} {
      allow read, get: if request.auth != null;
      allow create, delete: if isAdmin();
      allow list, update: if false;
    }
  }
}
