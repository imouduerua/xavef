
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      // An admin is any user whose UID exists in the /admins collection.
      // This now becomes the single source of truth for admin status.
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    function canGenerateCode(userId) {
      return exists(/databases/$(database)/documents/referralCodeGenerators/$(userId));
    }

    // Admins can perform a collection group query on transactions
    match /{path=**}/transactions/{transactionId} {
      allow list: if isAdmin();
    }

    match /users/{userId} {
      // A user can create their own user document if the data is valid and they are authenticated.
      allow create: if request.auth != null && request.auth.uid == userId 
                    && request.resource.data.uid == userId
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.solidaraBalance == 0
                    && request.resource.data.annualBalance == 0;

      // An authenticated user can read their own document.
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // An authenticated user can update their own document, but not protected fields.
      // Admins can update a user's document based on the more specific rule below.
      // This rule is now more secure and clear.
      allow update: if request.auth.uid == userId &&
          request.resource.data.solidaraBalance == resource.data.solidaraBalance &&
          request.resource.data.annualBalance == resource.data.annualBalance;

      // Admins can read any user document.
      allow get, list: if isAdmin(); 
      // No one can delete user documents for now.
      allow delete: if false;
    }

    match /referralCodes/{codeId} {
      // An authenticated user needs to be able to check if a code exists during signup.
      allow read: if request.auth != null;
      
      allow create: if request.auth != null 
      								&& request.resource.data.creatorUid == request.auth.uid
                      && canGenerateCode(request.auth.uid);
      
      // A user can mark a code as used as part of the transaction to create their own profile.
      allow update: if request.auth != null 
                     && request.resource.data.used == true
                     && resource.data.used == false
                     && request.resource.data.usedBy == request.auth.uid;

      allow delete: if false;
    }

    match /referralCodeGenerators/{userId} {
      allow read, get: if request.auth != null;
      // Admins can create or delete permission documents.
      allow create, delete: if isAdmin();
      allow list, update: if false;
    }

    match /users/{userId}/transactions/{transactionId} {
        // Users can read their own transactions
        allow read: if request.auth != null && request.auth.uid == userId;
        // Users can create their own transactions (deposits/withdrawals)
        allow create: if request.auth != null && request.auth.uid == userId;
        // Admins can read and update transactions (e.g., to change status)
        allow get, list, update: if isAdmin();
        // Users cannot update or delete their own transactions
        allow delete: if false;
    }

    match /users/{userId}/goals/{goalId} {
        // Users can manage their own saving goals.
        allow create, read, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    match /admins/{userId} {
      // Any authenticated user can check if another user is an admin.
      allow read, get: if request.auth != null;
      // Only other admins can create or delete admin documents.
      allow create, delete: if isAdmin();
      allow list, update: if false;
    }
  }
}
