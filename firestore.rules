
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // Helper Functions
    // =====================================================================
    function isAuthOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'admin@xavef.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }
    
    // =====================================================================
    // User Collection & Subcollections
    // =====================================================================
    match /users/{userId} {
      // READ: Users can read their own profile. Admins can read any profile.
      allow get: if isAuthOwner(userId) || isAdmin();
      allow list: if isAdmin();

      // CREATE: A user can create their own document.
      allow create: if isAuthOwner(userId);
      
      // UPDATE: A user can update their own non-sensitive info.
      // Admins can ONLY update balance fields as part of a transaction.
      allow update: if (isAuthOwner(userId)
                    && !('solidaraBalance' in request.resource.data.diff(resource.data).affectedKeys())
                    && !('annualBalance' in request.resource.data.diff(resource.data).affectedKeys())
                    && !('xavefId' in request.resource.data.diff(resource.data).affectedKeys()))
                 || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['solidaraBalance', 'annualBalance']));

      allow delete: if false;

      // --- Subcollections ---
      
      // Transactions
      match /transactions/{transactionId} {
        // Users can read/list their own transactions.
        allow list, get: if isAuthOwner(userId);
        
        // Users can create new transactions (e.g., a deposit request).
        allow create: if isAuthOwner(userId);

        // Admins can read, update, or delete any transaction. This is necessary for the approval workflow.
        allow read, write, delete: if isAdmin();
      }
      
      // Notifications
      match /notifications/{notificationId} {
          // Users can read and modify their own notifications (e.g., mark as read).
          allow read, list, update: if isAuthOwner(userId);
          // Admins can create notifications for users as part of transaction approvals/declines.
          allow create: if isAdmin();
          allow delete: if false;
      }
      
      // Goals
      match /goals/{goalId} {
          // Users have full control over their own goals.
          allow read, write, delete: if isAuthOwner(userId);
      }
    }

    // =====================================================================
    // Root Collections
    // =====================================================================

    // Referral Codes
    match /referralCodes/{codeId} {
      allow read: if request.auth != null;
      allow create: if isAuthOwner(request.resource.data.creatorUid);
      allow update: if resource.data.used == false && request.resource.data.used == true && request.auth != null;
      allow delete: if false;
    }

    // Admins
    match /admins/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.email == 'admin@xavef.com';
    }
    
    // Groups
    match /groups/{groupId} {
        allow read: if request.auth != null;
        allow create: if isAuthOwner(request.resource.data.creatorUid);
        allow update: if isAuthOwner(resource.data.creatorUid) || isAdmin();
    }
    
    // Join Requests
    match /joinRequests/{requestId} {
        allow create: if isAuthOwner(request.resource.data.requesterUid);
        allow read: if isAuthOwner(request.resource.data.requesterUid) || isAuthOwner(get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.creatorUid);
        allow update: if isAuthOwner(get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.creatorUid);
    }

    // FCM Tokens for Push Notifications
    match /fcmTokens/{userId} {
      allow read, write: if isAuthOwner(userId) && isAdmin();
    }
    
    // Admins need to be able to query the 'transactions' collection group
    // for the admin pages. This is a read-only rule.
    match /{path=**}/transactions/{transactionId} {
        allow read: if isAdmin();
    }
  }
}
