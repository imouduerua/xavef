
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // Helper Functions
    // =====================================================================
    function isAuthOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      // The super admin email or any user ID present in the /admins collection is an admin.
      return request.auth != null && (
        request.auth.token.email == 'admin@xavef.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }
    
    // =====================================================================
    // User Collection & Subcollections
    // =====================================================================
    match /users/{userId} {
      // READ: Users can read their own profile. Admins can read any profile.
      // The `get` permission is CRITICAL for the transaction approval process.
      allow get: if isAuthOwner(userId) || isAdmin();
      
      // LIST: Only admins can list all user profiles.
      allow list: if isAdmin();

      // CREATE: A user can create their own document during signup.
      allow create: if isAuthOwner(userId);
      
      // UPDATE: This is the most critical section for fixing the bug.
      // We need two separate rules for updates to handle different permissions.
      
      // 1. A user can update their own non-sensitive, non-balance fields.
      allow update: if isAuthOwner(userId) && 
                      !('solidaraBalance' in request.resource.data) &&
                      !('annualBalance' in request.resource.data) &&
                      !('xavefId' in request.resource.data);

      // 2. An admin can ONLY update the balance fields.
      // This rule is what allows the transaction approval to succeed.
      // It checks that the only keys being changed are the balance keys.
      allow update: if isAdmin() && 
                      request.resource.data.keys().hasOnly(['solidaraBalance', 'annualBalance']) &&
                      request.resource.data.solidaraBalance == resource.data.solidaraBalance + request.resource.data.amount &&
                      request.resource.data.annualBalance == resource.data.annualBalance;


      // DELETE: No one can delete user profiles.
      allow delete: if false;

      // --- Subcollections ---
      
      // Transactions
      match /transactions/{transactionId} {
        // A user can read their own transactions.
        allow list, get: if isAuthOwner(userId);
        
        // A user can create a new transaction (e.g., a deposit or withdrawal request).
        allow create: if isAuthOwner(userId);

        // An admin can read, update, or delete any transaction. 
        // This is necessary for the approval/decline workflow.
        allow read, write, delete: if isAdmin();
      }
      
      // Notifications
      match /notifications/{notificationId} {
          // Users can read and update their own notifications (e.g., mark as read).
          allow read, list, update: if isAuthOwner(userId);

          // Admins can create notifications as part of the transaction workflow.
          allow create: if isAdmin();
          
          allow delete: if false;
      }
      
      // Goals
      match /goals/{goalId} {
          // Users have full control over their own goals.
          allow read, write, delete: if isAuthOwner(userId);
      }
    }

    // =====================================================================
    // Root Collections
    // =====================================================================

    // Referral Codes
    match /referralCodes/{codeId} {
      allow read: if request.auth != null;
      allow create: if isAuthOwner(request.resource.data.creatorUid);
      allow update: if resource.data.used == false && request.resource.data.used == true && request.auth != null;
      allow delete: if false;
    }

    // Admins
    match /admins/{userId} {
      // Only the super admin can add or remove other admins.
      allow read: if request.auth != null;
      allow write: if request.auth.token.email == 'admin@xavef.com';
    }
    
    // Groups
    match /groups/{groupId} {
        allow read: if request.auth != null;
        allow create: if isAuthOwner(request.resource.data.creatorUid);
        // The group creator or an admin can update a group.
        allow update: if isAuthOwner(resource.data.creatorUid) || isAdmin();
    }
    
    // Join Requests
    match /joinRequests/{requestId} {
        allow create: if isAuthOwner(request.resource.data.requesterUid);
        // The requester or the group creator can read the request.
        allow read: if isAuthOwner(request.resource.data.requesterUid) || isAuthOwner(get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.creatorUid);
        // Only the group creator can approve or decline the request.
        allow update: if isAuthOwner(get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.creatorUid);
    }

    // FCM Tokens for Push Notifications
    match /fcmTokens/{userId} {
      // Only an authenticated admin can read/write their own token.
      allow read, write: if isAuthOwner(userId) && isAdmin();
    }
    
    // This allows admins to perform the collectionGroup query needed for the admin pages.
    match /{path=**}/transactions/{transactionId} {
        allow read: if isAdmin();
    }
  }
}
