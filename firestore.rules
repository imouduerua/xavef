
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth.uid == userId;
    }

    match /referralCodes/{codeId} {
      allow create: if request.auth != null && request.resource.data.creatorUid == request.auth.uid;
      
      // Allow an authenticated user to update a code to mark it as used (from false to true)
      allow update: if request.auth != null
                     && request.resource.data.used == true
                     && resource.data.used == false;
      
      // No one can read or delete referral codes directly, except for reads during signup check.
      // A full read is disallowed to prevent enumeration.
      allow read, delete: if false;
    }

    match /users/{userId}/transactions/{transactionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
