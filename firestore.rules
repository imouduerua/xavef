
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      // A user can only read or update their own document.
      allow read, update: if request.auth != null && request.auth.uid == userId;
      
      // Creation is handled by a trusted server-side environment (Admin SDK), not by clients.
      // No client-side creation is allowed.
      allow create: if false; 
    }

    match /referralCodes/{codeId} {
      // Allow an authenticated user to create a referral code for themselves.
      allow create: if request.auth != null && request.resource.data.creatorUid == request.auth.uid;
      
      // Do not allow client-side updates. This is handled by a trusted server environment.
      allow update: if false;
      
      // Do not allow reading or deleting referral codes directly to prevent enumeration.
      allow read, delete: if false;
    }

    match /users/{userId}/transactions/{transactionId} {
        // Allow read and write for the user on their own transactions.
        allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
