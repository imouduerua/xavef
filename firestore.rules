
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // A user can read and create their own user profile.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
    }

    // A user can create a referral code for themselves.
    // A new user can update a referral code to mark it as used during signup.
    // No one can read or delete referral codes directly.
    match /referralCodes/{codeId} {
      allow create: if request.auth != null && request.resource.data.creatorUid == request.auth.uid;
      allow update: if request.auth != null && request.resource.data.used == true && resource.data.used == false;
      allow read, delete: if false;
    }

    match /users/{userId}/transactions/{transactionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
