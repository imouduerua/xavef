rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admins can perform a collection group query on transactions
    match /{path=**}/transactions/{transactionId} {
      allow list: if isAdmin();
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read, update, get: if isAdmin(); // Admin can read and update user docs
    }

    match /referralCodes/{codeId} {
      allow create: if request.auth != null && request.resource.data.creatorUid == request.auth.uid;
      allow read, update, delete: if false;
    }

    match /users/{userId}/transactions/{transactionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow read, update: if isAdmin(); // Admin can read and update transactions
    }

    match /admins/{userId} {
      allow read, get: if request.auth != null;
    }
  }
}
