
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // Helper Functions
    // =====================================================================

    function isAuthOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth.token.email == 'admin@xavef.com'
             || exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    // =====================================================================
    // User Collection Rules
    // =====================================================================
    match /users/{userId} {
      // Admins can read any user profile. Users can read their own.
      allow get: if isAuthOwner(userId) || isAdmin();
      // Only admins can list users.
      allow list: if isAdmin();

      // New users can create their own profile with specific initial values.
      allow create: if isAuthOwner(userId)
                    && request.resource.data.uid == userId
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.solidaraBalance == 0
                    && request.resource.data.annualBalance == 0;

      // Users can update their own non-critical profile information.
      allow update: if isAuthOwner(userId) &&
                     !('solidaraBalance' in request.resource.data.diff(resource.data).affectedKeys()) &&
                     !('annualBalance' in request.resource.data.diff(resource.data).affectedKeys()) &&
                     !('xavefId' in request.resource.data.diff(resource.data).affectedKeys()) &&
                     !('referredBy' in request.resource.data.diff(resource.data).affectedKeys()) &&
                     !('isAdmin' in request.resource.data.diff(resource.data).affectedKeys());
      
      // Admins can ONLY update the balance fields of a user.
      // This is the critical rule for transaction approvals.
      allow update: if isAdmin() &&
                  request.resource.data.diff(resource.data).affectedKeys().hasOnly(['solidaraBalance', 'annualBalance']);

      allow delete: if false; 
    }

    // =====================================================================
    // User Subcollection Rules
    // =====================================================================

    match /users/{userId}/transactions/{transactionId} {
      // Users can create their own transactions (e.g., a deposit request).
      allow create: if isAuthOwner(userId);
      // Users and admins can view individual transactions.
      allow get: if isAuthOwner(userId) || isAdmin();
      // Users can list their own transactions.
      allow list: if isAuthOwner(userId);
      // Admins can update or delete transactions (for approval/decline).
      allow update, delete: if isAdmin();
    }
    
    match /users/{userId}/notifications/{notificationId} {
        // Users can read and update (e.g., mark as read) their own notifications.
        allow read, list, update: if isAuthOwner(userId);
        // Admins can create notifications for users.
        allow create: if isAdmin();
        allow delete: if false; // Notifications should not be deletable by client.
    }
    
    match /users/{userId}/goals/{goalId} {
        // Users have full control over their own saving goals.
        allow read, write: if isAuthOwner(userId);
    }

    // =====================================================================
    // Global Collection Rules
    // =====================================================================

    // This collection group match is necessary for admins to query
    // all transactions across all users for the admin dashboards.
    match /{path=**}/transactions/{transactionId} {
        allow list: if isAdmin();
    }

    match /referralCodes/{codeId} {
      // Any authenticated user can read a referral code to validate it.
      allow read: if request.auth != null;
      // An authenticated user can create a referral code for themselves.
      allow create: if isAuthOwner(request.resource.data.creatorUid);
      // A code can be updated from 'used: false' to 'used: true' by a new user.
      allow update: if resource.data.used == false
                    && request.resource.data.used == true
                    && request.auth != null;
      allow delete: if false;
    }

    match /admins/{userId} {
      // Any authenticated user can see who is an admin.
      allow read: if request.auth != null;
      // Only the super admin can add or remove other admins.
      allow write: if request.auth.token.email == 'admin@xavef.com';
    }
    
    match /groups/{groupId} {
        // Any authenticated user can read group info.
        allow read: if request.auth != null;
        // Users can create groups where they are the creator.
        allow create: if isAuthOwner(request.resource.data.creatorUid);
        // Only the group creator can update a group (e.g., to start it).
        allow update: if isAuthOwner(resource.data.creatorUid);
    }
    
    match /joinRequests/{requestId} {
        // Users can create requests to join groups.
        allow create: if isAuthOwner(request.resource.data.requesterUid);
        // The requester and the group creator can read the request.
        allow read: if isAuthOwner(request.resource.data.requesterUid)
                      || isAuthOwner(get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.creatorUid);
        // Only the group creator can approve or decline a request.
        allow update: if isAuthOwner(get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.creatorUid);
    }

    match /fcmTokens/{userId} {
      // Only an admin user can write their own token.
      allow read, write: if isAuthOwner(userId) && isAdmin();
    }
  }
}
