
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      // Super admin is defined by a specific email address.
      // Other admins are defined by their existence in the 'admins' collection.
      return request.auth.token.email == 'admin@xavef.com' 
             || exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isAuthOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      // Admins can read any user profile. Users can read their own.
      allow get: if isAuthOwner(userId) || isAdmin();
      allow list: if isAdmin();

      // Users can be created.
      allow create: if isAuthOwner(userId)
                    && request.resource.data.uid == userId
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.solidaraBalance == 0
                    && request.resource.data.annualBalance == 0;

      // A user can update their own non-sensitive profile info.
      allow update: if isAuthOwner(userId) &&
                     !('solidaraBalance' in request.resource.data.diff(resource.data).affectedKeys()) &&
                     !('annualBalance' in request.resource.data.diff(resource.data).affectedKeys()) &&
                     !('xavefId' in request.resource.data.diff(resource.data).affectedKeys()) &&
                     !('referredBy' in request.resource.data.diff(resource.data).affectedKeys());
      
      // An admin can ONLY update the balance fields of a user. This rule is crucial for approvals.
      allow update: if isAdmin() &&
                  request.resource.data.diff(resource.data).affectedKeys().hasOnly(['solidaraBalance', 'annualBalance']);

      allow delete: if false; // Do not allow users to be deleted.
    }

    match /referralCodes/{codeId} {
      allow read: if request.auth != null;
      allow create: if isAuthOwner(request.resource.data.creatorUid);
      
      // Allow a user to claim a referral code.
      allow update: if resource.data.used == false 
                    && request.resource.data.used == true
                    && isAuthOwner(request.resource.data.usedBy);

      allow delete: if false;
    }

    match /users/{userId}/transactions/{transactionId} {
        // A user can create their own transactions.
        allow create: if isAuthOwner(userId);
        
        // A user can read their own transactions. An admin can read ANY transaction.
        allow get, list: if isAuthOwner(userId) || isAdmin();

        // Admins can update a transaction status, or delete it (for declines)
        allow update, delete: if isAdmin();
    }
    
    // This rule allows admins to perform a collectionGroup query across all users' transactions.
    match /{path=**}/transactions/{transactionId} {
        allow list: if isAdmin();
    }
    
    match /users/{userId}/goals/{goalId} {
        allow read, write: if isAuthOwner(userId);
    }
    
    match /users/{userId}/notifications/{notificationId} {
        allow read, list, update: if isAuthOwner(userId);
        // Admin can create notifications for users as part of a transaction batch.
        allow create: if isAdmin(); 
        allow delete: if false;
    }

    match /admins/{userId} {
      allow read, get: if request.auth != null;
      // Only the super admin can add or remove other admins.
      allow write: if request.auth.token.email == 'admin@xavef.com';
    }
    
    match /fcmTokens/{userId} {
      // Only an admin user can create or update their own FCM token document.
      allow read, write: if isAuthOwner(userId) && isAdmin();
    }

    // Group-related rules
    match /groups/{groupId} {
        allow read: if request.auth != null;
        allow create: if isAuthOwner(request.resource.data.creatorUid);
        // Only the group creator can update the group (e.g. start it, add members via request approval)
        allow update: if isAuthOwner(resource.data.creatorUid);
    }

    match /joinRequests/{requestId} {
        allow create: if isAuthOwner(request.resource.data.requesterUid);
        allow read: if isAuthOwner(request.resource.data.requesterUid) 
                      || isAuthOwner(get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.creatorUid);
        // Only group creators can update the status of a request for their group
        allow update: if isAuthOwner(get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.creatorUid);
    }
  }
}
