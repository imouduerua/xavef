
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      // A user can only read or update their own document.
      allow read, update: if request.auth != null && request.auth.uid == userId;
      
      // Client-side creation is disallowed. It must be done via a trusted server environment (e.g. Admin SDK).
      allow create: if false; 
    }

    match /referralCodes/{codeId} {
      // Client-side creation and updates are disallowed. They must be done via a trusted server environment.
      allow create, update: if false;
      
      // Do not allow reading or deleting referral codes directly to prevent enumeration.
      allow read, delete: if false;
    }

    match /users/{userId}/transactions/{transactionId} {
        // Allow read and write for the user on their own transactions.
        allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
