
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, update: if request.auth != null && request.auth.uid == userId;
      // Allow a user to create their own document.
      allow create: if request.auth.uid == userId;
    }

    match /referralCodes/{codeId} {
      // Allow a logged-in user to create a referral code for themselves
      allow create: if request.auth != null && request.resource.data.creatorUid == request.auth.uid;
      
      // Allow an authenticated user to update a code to mark it as used (from false to true)
      allow update: if request.auth != null
                     && request.resource.data.used == true
                     && resource.data.used == false;
      
      // No one can read or delete referral codes directly
      allow read, delete: if false;
    }

    match /users/{userId}/transactions/{transactionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
