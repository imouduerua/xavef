
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read, create, and update their OWN document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Referral codes are write-only from the client.
    // Authenticated users can create a new referral code for themselves.
    // They cannot be read or updated from the client to prevent guessing or modification.
    match /referralCodes/{codeId} {
      allow create: if request.auth != null && request.resource.data.creatorUid == request.auth.uid;
      allow read, update, delete: if false;
    }

    // Users can manage their own transactions.
    match /users/{userId}/transactions/{transactionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
