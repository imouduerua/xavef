
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      // Allow a user to read their own profile
      allow read: if request.auth != null && request.auth.uid == userId;
      // Allow a user to create their own profile, checking the UID in the resource data
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    match /referralCodes/{codeId} {
      // Allow a logged-in user to create a referral code for themselves
      allow create: if request.auth != null && request.resource.data.creatorUid == request.auth.uid;
      // Allow a newly-signing-up user to mark a code as used
      allow update: if request.resource.data.used == true && resource.data.used == false;
      allow read, delete: if false;
    }

    match /users/{userId}/transactions/{transactionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
