
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // WARNING: These rules are permissive and are intended for development only.
    // They allow any authenticated user to read and write any data.
    // You MUST secure these rules before launching your application.
    match /{path=**} {
      allow read, write: if request.auth != null;
    }
  }
}
