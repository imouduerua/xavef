
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // Helper Functions
    // =====================================================================
    function isAuthOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isSuperAdmin() {
        return request.auth != null && request.auth.token.email == 'admin@xavef.com';
    }

    function isAdmin() {
      return isSuperAdmin() || (request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }
    
    // =====================================================================
    // User Collection & Subcollections
    // =====================================================================
    match /users/{userId} {
      // READ: An admin can read any user's profile. A user can read their own.
      allow get, read: if isAuthOwner(userId) || isAdmin();
      
      // LIST: Admins can list all users for the user management page.
      allow list: if isAdmin();
      
      // UPDATE (User): A user can update their own profile, but cannot change protected fields.
      allow update: if isAuthOwner(userId)
                      && !('solidaraBalance' in request.resource.data)
                      && !('annualBalance' in request.resource.data);
      
      // WRITE (Admin): An admin can update any part of a user's profile.
      allow write: if isAdmin();

      // CREATE: A newly authenticated user can create their own profile document.
      allow create: if isAuthOwner(userId);

      // --- Subcollections ---
      
      // Transactions
      match /transactions/{transactionId} {
        // A user can read their own transactions.
        allow read: if isAuthOwner(userId);
        
        // A user can create their own transaction (e.g. initiating a deposit/withdrawal).
        allow create: if isAuthOwner(userId);
        
        // Admins can read and write any transaction. This is necessary for approvals.
        allow read, write: if isAdmin();
      }
      
      // Notifications
      match /notifications/{notificationId} {
          allow read, list, update: if isAuthOwner(userId);
          allow create: if isAdmin();
          allow delete: if false;
      }
      
      // Goals
      match /goals/{goalId} {
          // Users have full control over their own goals.
          allow read, write, delete: if isAuthOwner(userId);
      }
    }

    // =====================================================================
    // Root Collections
    // =====================================================================

    // Referral Codes
    match /referralCodes/{codeId} {
      // Allow authenticated users to read/list to find a code during registration.
      allow read, list: if request.auth != null;
      allow create: if isAuthOwner(request.resource.data.creatorUid);
      // Allow an authenticated user to update a code ONLY to mark it as used.
      allow update: if request.auth != null
                      && resource.data.used == false 
                      && request.resource.data.used == true
                      && request.resource.data.keys().hasAll(['used', 'usedBy', 'usedAt'])
                      && request.resource.data.size() == 3;
      allow delete: if false;
    }

    // Admins
    match /admins/{userId} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin();
    }
    
    // Groups
    match /groups/{groupId} {
        allow read: if request.auth != null;
        allow create: if isAuthOwner(request.resource.data.creatorUid);
        allow update: if isAuthOwner(resource.data.creatorUid) || isAdmin();
    }
    
    // Join Requests
    match /joinRequests/{requestId} {
        allow create: if isAuthOwner(request.resource.data.requesterUid);
        allow read: if isAuthOwner(request.resource.data.requesterUid) || isAuthOwner(get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.creatorUid);
        allow update: if isAuthOwner(get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.creatorUid);
    }

    // FCM Tokens for Push Notifications
    match /fcmTokens/{userId} {
      allow read, write: if isAuthOwner(userId) && isAdmin();
    }
    
    // This allows admins to perform the collectionGroup query needed for the admin pages.
    match /{path=**}/transactions/{transactionId} {
        allow list: if isAdmin();
    }
  }
}
