
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth.token.email == 'admin@xavef.com' || exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    match /users/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId 
                    && request.resource.data.uid == userId
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.solidaraBalance == 0
                    && request.resource.data.annualBalance == 0;

      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      
      // A user can update their profile, but NOT their balance or sensitive fields managed by admin.
      allow update: if request.auth.uid == userId &&
                     !('solidaraBalance' in request.resource.data.diff(resource.data).affectedKeys()) &&
                     !('annualBalance' in request.resource.data.diff(resource.data).affectedKeys()) &&
                     !('xavefId' in request.resource.data.diff(resource.data).affectedKeys()) &&
                     !('referredBy' in request.resource.data.diff(resource.data).affectedKeys());
      
      // An admin can ONLY update the balances
      allow update: if isAdmin() &&
                  request.resource.data.diff(resource.data).affectedKeys().hasOnly(['solidaraBalance', 'annualBalance']);

      allow delete: if false;
    }

    match /referralCodes/{codeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.creatorUid == request.auth.uid;
      
      allow update: if request.auth != null 
                     && request.resource.data.used == true
                     && resource.data.used == false
                     && "usedBy" in request.resource.data && request.resource.data.usedBy == request.auth.uid;

      allow delete: if false;
    }

    match /users/{userId}/transactions/{transactionId} {
        // User can read and create their own transactions
        allow read, create: if request.auth != null && request.auth.uid == userId;

        // Admins can update any transaction
        allow update: if isAdmin();
        
        allow delete: if false;
    }
    
    // This rule allows admins to perform a collectionGroup query on 'transactions'
    match /{path=**}/transactions/{transactionId} {
        allow list: if isAdmin();
    }
    
    match /users/{userId}/goals/{goalId} {
        allow create, read, update, delete: if request.auth != null && request.auth.uid == userId;
    }
    
    match /users/{userId}/notifications/{notificationId} {
        allow read, list, update: if request.auth != null && request.auth.uid == userId;
        // Allow server-side/trusted creation only. For now, relax to authenticated.
        allow create: if request.auth != null; 
        allow delete: if false;
    }

    match /admins/{userId} {
      allow read, get: if request.auth != null;
      allow create, delete: if request.auth.token.email == 'admin@xavef.com';
    }
    
    match /fcmTokens/{userId} {
      // Only an admin user can create or update their own FCM token document.
      allow read, write: if request.auth != null && request.auth.uid == userId && isAdmin();
    }

    match /groups/{groupId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.creatorUid == request.auth.uid;
        
        // The group creator can update the group, but with specific constraints.
        allow update: if request.auth != null && resource.data.creatorUid == request.auth.uid;
    }

    match /joinRequests/{requestId} {
        allow create: if request.auth != null && request.resource.data.requesterUid == request.auth.uid;
        allow read, list: if request.auth != null && (get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.creatorUid == request.auth.uid || request.resource.data.requesterUid == request.auth.uid);
        allow update: if request.auth != null && get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.creatorUid == request.auth.uid;
        allow delete: if false;
    }
  }
}

    