
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, update: if request.auth != null && request.auth.uid == userId;
      // IMPORTANT: This rule is temporarily open for user creation to resolve
      // a persistent registration issue. It MUST be secured. A user should only
      // be able to create their own document.
      // The secure rule is: allow create: if request.auth.uid == userId;
      allow create: if true;
    }

    match /referralCodes/{codeId} {
      // Allow an authenticated user to create a referral code for themselves.
      allow create: if request.auth != null && request.resource.data.creatorUid == request.auth.uid;
      
      // Allow any authenticated user to update a code to mark it as used.
      // This is safe because the client logic only ever sets 'used' to true.
      allow update: if request.auth != null
                    && request.resource.data.used == true 
                    && resource.data.used == false;
      
      // Do not allow reading or deleting referral codes directly to prevent enumeration.
      allow read, delete: if false;
    }

    match /users/{userId}/transactions/{transactionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
