
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      // Allow the super admin full access, and check the admins collection for others.
      return request.auth.token.email == 'admin@xavef.com' || exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admins can perform a collection group query on transactions
    match /{path=**}/transactions/{transactionId} {
      allow list: if isAdmin();
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Admins can read any user document
      allow get, list: if isAdmin(); 
      // Admins can update user documents
      allow update: if isAdmin();
    }

    match /referralCodes/{codeId} {
      allow create: if request.auth != null && request.resource.data.creatorUid == request.auth.uid;
      // No one can read or update a referral code after it's created, except to mark it as used by the createUserProfile action.
      allow read, update, delete: if false;
    }

    match /users/{userId}/transactions/{transactionId} {
        // Users can read and create their own transactions
        allow read, create: if request.auth != null && request.auth.uid == userId;
        // Admins can read and update transactions (e.g., to change status)
        allow get, list, update: if isAdmin();
        // Users cannot update or delete their own transactions
        allow update, delete: if false;
    }

    match /admins/{userId} {
      // Any authenticated user can check if another user is an admin.
      // This is safe as it only reveals a boolean status.
      allow read, get: if request.auth != null;
    }
  }
}
