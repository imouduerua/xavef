
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow create: if false; 
    }

    match /referralCodes/{codeId} {
      // Allow authenticated users to create a referral code document, but only if they are the creator.
      allow create: if request.auth != null && request.resource.data.creatorUid == request.auth.uid;
      
      // Do not allow reading, updating, or deleting referral codes directly to prevent enumeration or misuse.
      allow read, update, delete: if false;
    }

    match /users/{userId}/transactions/{transactionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
